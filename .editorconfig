# EditorConfig (https://editorconfig.org) — keeps editors aligned with the
# project's code convention: https://ph7builder.com/doc/en/code-convention
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing double-spaces are meaningful line breaks in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
